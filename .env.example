# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Shared secret used by the GitHub Actions scheduler.
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
